# ─── Database (MySQL) ──────────────────────────────────
DATABASE_URL="mysql://root@localhost:3306/bestari"

# ─── JWT ────────────────────────────────────────────────
JWT_SECRET="ganti-dengan-secret-key-aman-anda"
JWT_EXPIRES_IN="7d"

# ─── Server ─────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ─── Upload ─────────────────────────────────────────────
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# SCM data dummy (pilihan "Data Dummy" di Data Sorgum)
EXTERNAL_SCM_DEMO_API_BASE=https://scm1.livinglabs.id/api
EXTERNAL_SCM_DEMO_API_KEY=
